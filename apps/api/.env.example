# Окружение dev-сервера API (npm run dev:api) и миграций (npm run db:migrate).
# Скопируйте в .env и заполните:
# .env в .gitignore, в репозиторий не попадает.

# Строка подключения к dev-ветке Neon: Console → Branches → dev → Connect.
# Прямой адрес, без «Connection pooling»: адрес с `-pooler` в хосте миграции отклоняют.
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Локальный стенд вместо Neon (apps/api/stand/docker-compose.yml). Интеграционные
# тесты стирают базу стенда целиком — не держите в нём данные, которые жалко.
# DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/main
